---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { about } from "../data/about";
import { site } from "../data/site";
import type { IconName } from "./Icon.astro";

const blockIcons: Record<string, IconName> = {
  "Professional journey": "file-text",
  "How I work": "users",
  "Faith & ministry": "book-open",
};
---

<Section id="about" title="About me">
  <div class="grid items-start gap-12 lg:grid-cols-2">
    <div>
      <p class="text-lg leading-relaxed text-ink/80">{about.lead}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          about.identityTags.map((tag) => (
            <li class="rounded-full bg-secondary/30 px-3 py-1 text-sm font-medium text-primary">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-sm lg:mx-0 lg:ml-auto">
      <div
        class="pointer-events-none absolute -inset-4 -rotate-2 rounded-[2rem] bg-secondary/40 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-xl ring-1 ring-primary/15"
      >
        {
          site.headshot.src ? (
            <img
              src={site.headshot.src}
              alt={site.headshot.alt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          ) : (
            <div
              class="flex h-full w-full items-center justify-center bg-primary"
              aria-hidden="true"
            >
              <span class="font-serif text-6xl font-bold text-secondary">
                DM
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-3">
    {
      about.blocks.map((block) => {
        const isFaith = block.title === "Faith & ministry";
        return (
          <div
            class:list={[
              "flex flex-col rounded-2xl border p-6 sm:p-8",
              isFaith
                ? "border-secondary/60 bg-secondary/30"
                : "border-primary/10 bg-white",
            ]}
          >
            <span
              class:list={[
                "mb-4 flex h-10 w-10 items-center justify-center rounded-lg",
                isFaith
                  ? "bg-primary text-secondary"
                  : "bg-secondary/40 text-primary",
              ]}
              aria-hidden="true"
            >
              <Icon name={blockIcons[block.title] ?? "users"} class="h-5 w-5" />
            </span>
            <h3 class="font-serif text-xl font-bold text-primary">
              {block.title}
            </h3>
            <div class="mt-3 space-y-4 leading-relaxed text-ink/80">
              {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
        );
      })
    }
  </div>

  <blockquote
    class="mt-12 border-l-4 border-primary pl-6 font-serif text-xl leading-snug text-primary sm:text-2xl"
  >
    {about.closingLine}
  </blockquote>

  <div class="mt-12 border-t border-primary/15 pt-8">
    <h3 class="font-serif text-xl font-bold text-primary">Education</h3>
    <ul class="mt-6 space-y-6">
      {
        about.education.map((entry) => (
          <li class="flex gap-4">
            <span
              class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-secondary/40 text-primary"
              aria-hidden="true"
            >
              <Icon name="graduation-cap" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-semibold leading-snug text-primary">
                {entry.qualification}
              </p>
              <p class="mt-1 text-sm text-ink/70">
                {entry.institution} · {entry.period}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

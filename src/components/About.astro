---
import Section from "./Section.astro";
import { about } from "../data/about";
---

<Section id="about" title="About">
  <div class="grid gap-12 lg:grid-cols-3">
    <div class="space-y-5 text-lg leading-relaxed text-ink/80 lg:col-span-2">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside class="lg:col-span-1">
      <h3 class="font-serif text-xl font-bold text-primary">Education</h3>
      <ul class="mt-5 space-y-5">
        {
          about.education.map((entry) => (
            <li class="border-l-2 border-primary/30 pl-4">
              <p class="font-semibold text-primary">{entry.qualification}</p>
              <p class="text-sm text-ink/80">{entry.institution}</p>
              <p class="text-sm text-ink/60">{entry.period}</p>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>

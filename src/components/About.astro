---
import Section from "./Section.astro";
import { about } from "../data/about";
---

<Section id="about" title="About">
  <div class="grid gap-12 lg:grid-cols-3">
    <div class="space-y-5 text-lg leading-relaxed text-slate-600 lg:col-span-2">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside class="lg:col-span-1">
      <h3 class="font-serif text-xl font-bold text-slate-900">Education</h3>
      <ul class="mt-5 space-y-5">
        {
          about.education.map((entry) => (
            <li class="border-l-2 border-brand-200 pl-4">
              <p class="font-semibold text-slate-900">{entry.qualification}</p>
              <p class="text-sm text-slate-600">{entry.institution}</p>
              <p class="text-sm text-slate-500">{entry.period}</p>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>

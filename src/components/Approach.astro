---
import Section from "./Section.astro";
import { approach } from "../data/approach";
---

<Section id="approach" title="How I work" description={approach.intro}>
  <ol class="grid gap-6 sm:grid-cols-2">
    {
      approach.steps.map((step, index) => (
        <li class="flex gap-5 rounded-2xl border border-primary/10 bg-white p-6 shadow-sm">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary font-serif text-lg font-bold text-secondary"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div>
            <h3 class="font-semibold leading-snug text-primary">
              {step.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/80">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <ul class="mt-10 flex flex-wrap gap-3">
    {
      approach.principles.map((principle) => (
        <li class="rounded-full bg-secondary/30 px-4 py-1.5 text-sm font-medium text-primary">
          {principle}
        </li>
      ))
    }
  </ul>

  <div class="mt-12 rounded-2xl border border-primary/15 bg-surface/40 p-6 sm:p-8">
    <h3 class="font-serif text-xl font-bold text-primary">Who I work with</h3>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        approach.whoIWorkWith.map((audience) => (
          <li class="flex items-start gap-3">
            <span
              class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
              aria-hidden="true"
            />
            <span class="text-ink/80">{audience}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 border-t border-primary/15 pt-5 text-sm leading-relaxed text-ink/70">
      {approach.engagementTypes}
    </p>
  </div>
</Section>

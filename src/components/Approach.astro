---
import Section from "./Section.astro";
import { approach } from "../data/approach";
---

<Section
  id="approach"
  title="How I work"
  description={approach.intro}
  variant="surface"
>
  <ol class="grid gap-5 sm:grid-cols-2">
    {
      approach.steps.map((step, index) => (
        <li class="flex gap-5 rounded-xl border border-primary/10 bg-white p-5">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-serif text-base font-bold text-secondary"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div>
            <h3 class="font-semibold leading-snug text-primary">
              {step.title}
            </h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/80">
              {step.body}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <ul class="mt-8 flex flex-wrap gap-3">
    {
      approach.principles.map((principle) => (
        <li class="rounded-full bg-secondary/30 px-4 py-1.5 text-sm font-medium text-primary">
          {principle}
        </li>
      ))
    }
  </ul>

  <p class="mt-8 text-sm leading-relaxed text-ink/70">
    <span class="font-semibold text-primary">Who I work with:</span>{" "}
    {approach.whoIWorkWith.join(" · ")}. {approach.engagementTypes}
  </p>
</Section>

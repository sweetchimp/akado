---
import Section from "./Section.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { contact } from "../data/contact";
import { site } from "../data/site";
---

<Section id="contact" title={contact.heading} description={contact.intro}>
  <div class="grid gap-10 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <ul class="space-y-7">
        <li class="flex gap-4">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/40 text-primary"
            aria-hidden="true"
          >
            <Icon name="map-pin" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-primary">
              Location
            </p>
            <p class="mt-1 text-ink">{site.location}</p>
          </div>
        </li>

        <li class="flex gap-4">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/40 text-primary"
            aria-hidden="true"
          >
            <Icon name="mail" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-primary">
              Email
            </p>
            <a
              href={`mailto:${site.email}`}
              class="mt-1 inline-block break-all font-medium text-primary underline-offset-4 transition-colors hover:text-primary/80 hover:underline"
            >
              {site.email}
            </a>
          </div>
        </li>

        {
          site.linkedin && (
            <li class="flex gap-4">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-secondary/40 text-primary"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z" />
                </svg>
              </span>
              <div>
                <p class="text-sm font-semibold uppercase tracking-wider text-primary">
                  LinkedIn
                </p>
                <a
                  href={site.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-block font-medium text-primary underline-offset-4 transition-colors hover:text-primary/80 hover:underline"
                >
                  View LinkedIn profile
                </a>
              </div>
            </li>
          )
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          contact.downloads.map((download) => (
            <a
              href={download.href}
              download={download.download}
              type="application/pdf"
              class="inline-flex items-center gap-2 rounded-full border border-primary/30 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-primary hover:bg-primary/5"
            >
              {download.label}
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3v12" />
                <path d="m7 12 5 5 5-5" />
                <path d="M5 21h14" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <div class="lg:col-span-3">
      <div
        class="flex h-full flex-col items-center justify-center rounded-2xl border-2 border-secondary/60 bg-white p-8 text-center shadow-sm sm:p-10"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-secondary/40 text-primary"
          aria-hidden="true"
        >
          <Icon name="mail" class="h-7 w-7" />
        </span>
        <h3 class="mt-5 font-serif text-2xl font-bold text-primary">
          {contact.emailCtaHeading}
        </h3>
        <p class="mt-3 max-w-md text-ink/80">{contact.emailCtaText}</p>
        <div class="mt-7">
          <Button variant="primary" href={`mailto:${site.email}`}>
            {contact.emailButtonLabel}
          </Button>
        </div>
        <p class="mt-4 break-all text-sm text-ink/70">
          {site.email}
        </p>
      </div>
    </div>
  </div>
</Section>

---
import Section from "./Section.astro";
import Button from "./Button.astro";
import { contact } from "../data/contact";
import { site } from "../data/site";

const inputClass =
  "mt-2 w-full rounded-lg border border-primary/20 bg-white px-4 py-2.5 text-ink shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/30";
const labelClass = "block text-sm font-medium text-ink";
---

<Section id="contact" title={contact.heading} description={contact.intro}>
  <div class="grid gap-10 lg:grid-cols-5">
    <div class="space-y-6 lg:col-span-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Location
        </p>
        <p class="mt-1 text-ink">{site.location}</p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Email
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-1 inline-block font-medium text-primary underline-offset-4 transition-colors hover:text-primary/80 hover:underline"
        >
          {site.email}
        </a>
      </div>
    </div>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="grid gap-5 rounded-2xl border border-primary/15 bg-surface/40 p-6 shadow-sm sm:p-8 lg:col-span-3"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <div>
        <label class={labelClass} for="name">Name</label>
        <input
          class={inputClass}
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          required
        />
      </div>

      <div>
        <label class={labelClass} for="email">Email</label>
        <input
          class={inputClass}
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>

      <div>
        <label class={labelClass} for="organisation"
          >Organisation (optional)</label
        >
        <input
          class={inputClass}
          type="text"
          id="organisation"
          name="organisation"
          autocomplete="organization"
        />
      </div>

      <div>
        <label class={labelClass} for="message">Message</label>
        <textarea
          class={inputClass}
          id="message"
          name="message"
          rows="5"
          required></textarea>
      </div>

      <Button type="submit" variant="primary" class="justify-self-start">
        Send message
      </Button>
    </form>
  </div>
</Section>

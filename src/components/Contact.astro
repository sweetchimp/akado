---
import Section from "./Section.astro";
import { contact } from "../data/contact";
import { site } from "../data/site";

const inputClass =
  "mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 shadow-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30";
const labelClass = "block text-sm font-medium text-slate-700";
---

<Section id="contact" title={contact.heading} description={contact.intro}>
  <div class="grid gap-10 lg:grid-cols-5">
    <div class="space-y-6 lg:col-span-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Location
        </p>
        <p class="mt-1 text-slate-900">{site.location}</p>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Email
        </p>
        <a
          href={`mailto:${site.email}`}
          class="mt-1 inline-block font-medium text-brand-700 transition-colors hover:text-brand-800"
        >
          {site.email}
        </a>
      </div>
    </div>

    <form
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="grid gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <div>
        <label class={labelClass} for="name">Name</label>
        <input
          class={inputClass}
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          required
        />
      </div>

      <div>
        <label class={labelClass} for="email">Email</label>
        <input
          class={inputClass}
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>

      <div>
        <label class={labelClass} for="organisation">Organisation (optional)</label>
        <input
          class={inputClass}
          type="text"
          id="organisation"
          name="organisation"
          autocomplete="organization"
        />
      </div>

      <div>
        <label class={labelClass} for="message">Message</label>
        <textarea
          class={inputClass}
          id="message"
          name="message"
          rows="5"
          required></textarea>
      </div>

      <button
        type="submit"
        class="justify-self-start rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        Send message
      </button>
    </form>
  </div>
</Section>

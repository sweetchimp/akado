---
import Section from "./Section.astro";
import Achievements from "./Achievements.astro";
import { experience, recentConsultancies } from "../data/experience";
---

<Section id="experience" title="Experience">
  <ol class="relative list-none space-y-14 border-l border-primary pl-8">
    {
      experience.map((item, index) => (
        <li class="relative">
          <span
            class={[
              "absolute -left-10 top-1.5 h-4 w-4 rounded-full",
              index === 0 ? "bg-accent" : "bg-primary",
            ].join(" ")}
            aria-hidden="true"
          />
          <p class="text-sm font-semibold uppercase tracking-wider text-primary">
            {item.period}
          </p>
          {
            item.roles ? (
              <>
                <h3
                  class="mt-1 font-serif text-xl font-bold leading-snug text-primary"
                >
                  {item.organisation}
                </h3>
                {item.note && (
                  <p class="mt-1 text-sm italic text-ink/60">{item.note}</p>
                )}
                <div class="mt-6 rounded-2xl border border-primary/15 bg-surface/60 p-6 sm:p-8">
                  <ol class="list-none">
                    {item.roles.map((role, index) => (
                      <li
                        class={
                          index > 0 ? "mt-8 border-t border-primary/10 pt-8" : ""
                        }
                      >
                        <p class="text-sm font-semibold text-primary">
                          {role.period}
                        </p>
                        <h4
                          class="mt-1 font-serif text-lg font-bold text-primary"
                        >
                          {role.title}
                        </h4>
                        <p class="mt-2 text-sm leading-relaxed text-ink/80">
                          {role.summary}
                        </p>
                        <Achievements items={role.achievements} />
                      </li>
                    ))}
                  </ol>
                </div>
              </>
            ) : (
              <>
                <h3
                  class="mt-1 font-serif text-xl font-bold leading-snug text-primary"
                >
                  {item.role}
                </h3>
                <p class="mt-0.5 font-medium text-primary/80">
                  {item.organisation}
                </p>
                {item.location && (
                  <p class="mt-1 text-sm italic text-ink/60">{item.location}</p>
                )}
                {item.summary && (
                  <p class="mt-2 leading-relaxed text-ink/80">
                    {item.summary}
                  </p>
                )}
                {item.achievements && <Achievements items={item.achievements} />}
              </>
            )
          }
        </li>
      ))
    }
  </ol>

  <div class="mt-14 rounded-2xl border border-primary/15 bg-surface/60 p-6 sm:p-8">
    <h3 class="font-serif text-xl font-bold text-primary">
      Recent consultancy assignments
    </h3>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        recentConsultancies.map((item) => (
          <li class="rounded-xl border border-primary/10 bg-white p-5">
            <p class="text-sm font-semibold text-primary">{item.year}</p>
            <p class="mt-1 font-semibold text-primary">{item.client}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink/80">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
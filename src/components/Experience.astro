---
import Section from "./Section.astro";
import { experience } from "../data/experience";
---

<Section id="experience" title="Results that speak for themselves">
  <div
    class="grid gap-6 rounded-3xl bg-primary p-6 sm:grid-cols-2 sm:p-10"
    data-tone="dark"
  >
    {
      experience.highlights.map((highlight) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <p class="font-serif text-3xl font-bold tracking-tight text-accent sm:text-4xl">
            {highlight.figure}
          </p>
          <h3 class="mt-3 font-semibold leading-snug text-white">
            {highlight.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-secondary">
            {highlight.body}
          </p>
        </article>
      ))
    }
  </div>

  <div class="mt-14">
    <h3 class="font-serif text-xl font-bold text-primary">
      Selected assignments
    </h3>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        experience.assignments.map((assignment) => (
          <li class="rounded-xl border border-primary/10 bg-white p-5">
            <p class="text-sm font-semibold text-primary">{assignment.period}</p>
            <p class="mt-1 font-semibold text-primary">
              {assignment.client}
            </p>
            <p class="mt-2 text-sm leading-relaxed text-ink/80">
              {assignment.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-14">
    <h3 class="font-serif text-xl font-bold text-primary">Career timeline</h3>
    <ol class="mt-6 space-y-3">
      {
        experience.timeline.map((entry) => (
          <li>
            <details class="group rounded-2xl border border-primary/10 bg-white p-5 sm:p-6">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
                <span>
                  <span class="block font-semibold text-primary">
                    {entry.role}
                  </span>
                  <span class="mt-0.5 block text-sm text-ink/70">
                    {entry.organisation} &middot; {entry.period}
                  </span>
                </span>
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-primary transition-transform group-open:rotate-180"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-ink/80">
                {entry.summary}
              </p>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

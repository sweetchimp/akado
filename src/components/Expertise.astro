---
import Section from "./Section.astro";
import { expertiseAreas } from "../data/expertise";
---

<Section id="expertise" title="Expertise" variant="muted">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      expertiseAreas.map((area, index) => (
        <article class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md">
          <span class="font-serif text-sm font-bold text-brand-400">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 font-semibold leading-snug text-slate-900">
            {area.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            {area.description}
          </p>
        </article>
      ))
    }
  </div>
</Section>

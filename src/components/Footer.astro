---
import { site } from "../data/site";
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row"
  >
    <p>{site.footer}</p>
    <a
      href={`mailto:${site.email}`}
      class="font-medium text-slate-600 transition-colors hover:text-brand-700"
    >
      {site.email}
    </a>
  </div>
</footer>

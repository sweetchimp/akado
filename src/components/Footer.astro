---
import { site } from "../data/site";
---

<footer class="bg-ink" data-tone="dark">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm sm:flex-row"
  >
    <p class="text-secondary">{site.footer}</p>
    <a
      href={`mailto:${site.email}`}
      class="font-medium text-white transition-colors hover:text-secondary"
    >
      {site.email}
    </a>
  </div>
</footer>

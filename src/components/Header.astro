---
import Button from "./Button.astro";
import { navItems, navCta, site } from "../data/site";
---

<header
  class="sticky top-0 z-50 border-b border-primary/10 bg-white/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href="#home"
      class="font-serif text-base font-bold tracking-tight text-primary sm:text-lg"
    >
      {site.brand}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="text-sm font-medium text-ink transition-colors hover:text-primary"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Button
        href={navCta.href}
        variant="primary"
        size="sm"
        class="hidden sm:inline-flex"
      >
        {navCta.label}
      </Button>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex items-center justify-center rounded-md p-2 text-primary transition-colors hover:bg-primary/5 lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    class="hidden border-t border-primary/10 bg-white lg:hidden"
  >
    <div class="mx-auto flex max-w-6xl flex-col px-6 py-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="border-b border-primary/5 py-3 text-sm font-medium text-ink transition-colors last:border-none hover:text-primary"
          >
            {item.label}
          </a>
        ))
      }
      <Button
        href={navCta.href}
        variant="primary"
        size="sm"
        class="my-3 w-full sm:hidden"
      >
        {navCta.label}
      </Button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isHidden));
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }

  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]"),
  );

  if (navLinks.length > 0) {
    const activeClasses = [
      "text-primary",
      "font-semibold",
      "underline",
      "decoration-accent",
      "decoration-2",
      "underline-offset-8",
    ];

    const setActive = (hash: string) => {
      navLinks.forEach((link) => {
        const isActive = link.hash === hash;
        link.classList.toggle("text-ink", !isActive);
        activeClasses.forEach((cls) => link.classList.toggle(cls, isActive));
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const ids = Array.from(
      new Set(
        navLinks
          .map((link) => link.hash.replace(/^#/, ""))
          .filter((id) => id.length > 0),
      ),
    );

    const sections = ids
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    navLinks.forEach((link) => {
      link.addEventListener("click", () => setActive(link.hash));
    });

    if (sections.length > 0 && "IntersectionObserver" in window) {
      let current = "";

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              current = `#${entry.target.id}`;
            }
          });
          setActive(current);
        },
        { rootMargin: "-88px 0px -55% 0px", threshold: 0 },
      );

      sections.forEach((section) => observer.observe(section));
    }
  }
</script>

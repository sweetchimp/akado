---
import Button from "./Button.astro";
import StatsStrip from "./StatsStrip.astro";
import { hero } from "../data/hero";
---

<section
  id="home"
  data-tone="dark"
  class="scroll-mt-20 overflow-hidden bg-primary"
>
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-secondary">
      {hero.eyebrow}
    </p>
    <h1
      class="mt-5 max-w-3xl font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl"
    >
      {hero.name}
    </h1>
    <p class="mt-4 text-xl font-medium text-secondary sm:text-2xl">
      {hero.title}
    </p>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary/90">
      {hero.valueStatement}
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <Button variant="primary" href={hero.primaryCta.href}>
        {hero.primaryCta.label}
      </Button>
      <Button variant="outline-light" href={hero.secondaryCta.href}>
        {hero.secondaryCta.label}
      </Button>
    </div>
  </div>

  <StatsStrip />
</section>

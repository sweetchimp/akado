---
import Button from "./Button.astro";
import StatsStrip from "./StatsStrip.astro";
import { hero } from "../data/hero";
import { site } from "../data/site";
---

<section
  id="home"
  data-tone="dark"
  class="scroll-mt-20 overflow-hidden bg-gradient-to-b from-primary to-ink"
>
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p
          class="text-xs font-semibold uppercase tracking-[0.25em] text-secondary"
        >
          {hero.eyebrow}
        </p>
        <h1
          class="mt-5 font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl"
        >
          {hero.name}
        </h1>
        <p class="mt-4 text-xl font-medium text-secondary sm:text-2xl">
          {hero.title}
        </p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary/90">
          {hero.valueStatement}
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <Button variant="primary" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
          </Button>
          <Button variant="outline-light" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative mx-auto w-full max-w-sm">
          <div
            class="pointer-events-none absolute -inset-4 rotate-3 rounded-[2rem] bg-secondary/15 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl ring-1 ring-secondary/60"
          >
            {
              site.headshot.src ? (
                <img
                  src={site.headshot.src}
                  alt={site.headshot.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              ) : (
                <div
                  class="flex h-full w-full items-center justify-center bg-primary/50"
                  aria-hidden="true"
                >
                  <span class="font-serif text-6xl font-bold text-secondary sm:text-7xl">
                    DM
                  </span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <StatsStrip />
</section>

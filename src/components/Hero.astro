---
import Button from "./Button.astro";
import StatsStrip from "./StatsStrip.astro";
import PartnersStrip from "./PartnersStrip.astro";
import { hero } from "../data/hero";
import { about } from "../data/about";
import { site } from "../data/site";
---

<section
  id="home"
  data-tone="dark"
  class="scroll-mt-20 overflow-hidden bg-gradient-to-b from-primary to-ink"
>
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p
          class="text-xs font-semibold uppercase tracking-[0.25em] text-secondary"
        >
          {hero.eyebrow}
        </p>
        <h1
          class="mt-5 font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl"
        >
          {hero.name}
        </h1>
        <p
          class="mt-5 max-w-2xl font-serif text-2xl leading-snug text-secondary sm:text-3xl"
        >
          {about.lead}
        </p>
        <ul class="mt-7 flex flex-wrap gap-2">
          {
            about.identityTags.map((tag) => (
              <li class="rounded-full border border-secondary/40 bg-white/5 px-3 py-1 text-sm font-medium text-secondary">
                {tag}
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <Button variant="primary" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
          </Button>
          <Button variant="outline-light" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="relative mx-auto w-full max-w-md">
          <div
            class="pointer-events-none absolute -inset-4 rotate-2 rounded-[2rem] bg-secondary/20 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl ring-1 ring-secondary/60"
          >
            {
              site.headshot.src ? (
                <img
                  src={site.headshot.src}
                  alt={site.headshot.alt}
                  width="791"
                  height="1080"
                  decoding="async"
                  class="h-full w-full object-cover object-top"
                  loading="eager"
                />
              ) : (
                <div
                  class="flex h-full w-full items-center justify-center bg-primary/50"
                  aria-hidden="true"
                >
                  <span class="font-serif text-6xl font-bold text-secondary sm:text-7xl">
                    DM
                  </span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <StatsStrip />
  <PartnersStrip />
</section>

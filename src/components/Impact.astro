---
import Section from "./Section.astro";
import { impactItems } from "../data/impact";
---

<Section id="impact" title="Impact" variant="dark">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      impactItems.map((item) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8">
          <h3 class="font-serif text-xl font-bold leading-snug text-white">
            {item.title}
          </h3>
          <p class="mt-3 leading-relaxed text-slate-300">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>

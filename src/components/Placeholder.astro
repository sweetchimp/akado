---
interface Props {
  tone?: "light" | "dark";
  lines?: number;
  cards?: number;
  class?: string;
}

const { tone = "light", lines = 3, cards = 0, class: className = "" } = Astro.props;

const isDark = tone === "dark";
const strong = isDark ? "bg-white/25" : "bg-primary/20";
const soft = isDark ? "bg-white/10" : "bg-ink/10";
const cardClass = isDark
  ? "border-white/15 bg-white/5"
  : "border-primary/15 bg-white";

const widths = [100, 92, 84, 76, 68];
---

<div class={`space-y-4 ${className}`}>
  <div class={`h-6 w-1/3 rounded ${strong}`}></div>
  {
    Array.from({ length: lines }).map((_, index) => (
      <div
        class={`h-3 rounded ${soft}`}
        style={`width: ${widths[index % widths.length]}%`}
      />
    ))
  }
  {
    cards > 0 && (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {Array.from({ length: cards }).map(() => (
          <div class={`h-32 rounded-2xl border ${cardClass}`} />
        ))}
      </div>
    )
  }
</div>

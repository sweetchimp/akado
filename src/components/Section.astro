---
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  description?: string;
  variant?: "default" | "muted" | "dark";
}

const {
  id,
  title,
  eyebrow,
  description,
  variant = "default",
} = Astro.props;

const sectionClass =
  variant === "muted"
    ? "bg-slate-50"
    : variant === "dark"
      ? "bg-slate-900"
      : "bg-white";

const titleClass =
  variant === "dark" ? "text-white" : "text-slate-900";
const descriptionClass =
  variant === "dark" ? "text-slate-300" : "text-slate-600";
const eyebrowClass =
  variant === "dark" ? "text-brand-300" : "text-brand-700";
const dividerClass =
  variant === "dark" ? "bg-white/10" : "bg-slate-200";
---

<section id={id} class={`scroll-mt-20 border-t py-20 sm:py-24 ${sectionClass} ${variant === "default" ? "border-slate-200" : "border-transparent"}`}>
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-3xl">
      {
        eyebrow && (
          <p class={`text-sm font-semibold uppercase tracking-[0.2em] ${eyebrowClass}`}>
            {eyebrow}
          </p>
        )
      }
      <h2 class={`mt-3 font-serif text-3xl font-bold tracking-tight sm:text-4xl ${titleClass}`}>
        {title}
      </h2>
      <div class={`mt-5 h-px w-16 ${dividerClass}`}></div>
      {
        description && (
          <p class={`mt-5 text-lg leading-relaxed ${descriptionClass}`}>
            {description}
          </p>
        )
      }
    </div>
    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>

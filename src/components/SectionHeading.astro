---
interface Props {
  title: string;
  kicker?: string;
  eyebrow?: string;
  description?: string;
  level?: "h1" | "h2";
}

const { title, kicker, eyebrow, description, level = "h2" } = Astro.props;

const Tag = level;
---

<div class="max-w-3xl">
  {
    kicker && (
      <p class="text-sm font-semibold tracking-wide text-primary/70">
        {kicker}
      </p>
    )
  }
  {
    eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-primary">
        {eyebrow}
      </p>
    )
  }
  <Tag
    class="mt-4 font-serif text-3xl font-bold tracking-tight text-primary sm:text-4xl"
  >
    {title}
  </Tag>
  <div class="mt-5 flex items-center gap-3">
    <span class="h-0.5 w-12 rounded-full bg-primary"></span>
  </div>
  {
    description && (
      <p class="mt-5 text-lg leading-relaxed text-ink/80">{description}</p>
    )
  }
</div>

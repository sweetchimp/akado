---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  tone?: "light" | "dark";
  align?: "left" | "center";
}

const {
  title,
  eyebrow,
  description,
  tone = "light",
  align = "left",
} = Astro.props;

const isDark = tone === "dark";

const eyebrowClass = isDark ? "text-secondary" : "text-primary";
const titleClass = isDark ? "text-white" : "text-primary";
const descriptionClass = isDark ? "text-secondary" : "text-ink/80";
const lineClass = isDark ? "bg-accent" : "bg-primary";
const alignWrap = align === "center" ? "mx-auto text-center" : "";
const alignLine = align === "center" ? "justify-center" : "";
---

<div class={`max-w-3xl ${alignWrap}`}>
  {
    eyebrow && (
      <p
        class={`text-xs font-semibold uppercase tracking-[0.25em] ${eyebrowClass}`}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class={`mt-4 font-serif text-3xl font-bold tracking-tight sm:text-4xl ${titleClass}`}
  >
    {title}
  </h2>
  <div class={`mt-5 flex items-center gap-3 ${alignLine}`}>
    <span class={`h-0.5 w-12 rounded-full ${lineClass}`}></span>
  </div>
  {
    description && (
      <p class={`mt-5 text-lg leading-relaxed ${descriptionClass}`}>
        {description}
      </p>
    )
  }
</div>

---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { services, servicesIntro } from "../data/services";
---

<Section
  id="services"
  title="How I can help"
  description={servicesIntro}
  variant="surface"
>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service) => (
        <article class="flex flex-col rounded-2xl border border-primary/10 border-t-4 border-t-primary bg-white p-6 shadow-sm sm:p-7">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/40 text-primary"
            aria-hidden="true"
          >
            <Icon name={service.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 font-serif text-lg font-bold leading-snug text-primary">
            {service.title}
          </h3>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary/70">
            Who it&rsquo;s for
          </p>
          <p class="mt-1 text-sm leading-relaxed text-ink/80">
            {service.whoItsFor}
          </p>
          <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-primary/70">
            What I offer
          </p>
          <ul class="mt-2 list-disc space-y-2 pl-5 text-sm leading-relaxed text-ink/80">
            {service.offers.map((offer) => <li>{offer}</li>)}
          </ul>
          <p class="mt-6 border-t border-primary/10 pt-4 text-sm leading-relaxed text-ink/70">
            <span class="font-semibold text-primary">Proof point: </span>
            {service.proofPoint}
          </p>
        </article>
      ))
    }
  </div>
</Section>

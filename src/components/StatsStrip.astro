---
import { stats } from "../data/stats";
---

<div class="border-y border-slate-200 bg-white">
  <dl
    class="mx-auto grid max-w-6xl grid-cols-2 gap-px bg-slate-200 sm:grid-cols-4"
  >
    {
      stats.map((stat) => (
        <div class="bg-white px-6 py-8 text-center">
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <span class="block font-serif text-3xl font-bold text-brand-700">
              {stat.figure}
            </span>
            <span class="mt-2 block text-sm text-slate-600">{stat.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</div>

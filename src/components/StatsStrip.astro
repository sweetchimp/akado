---
import { formatStat, stats } from "../data/stats";
---

<div class="border-t border-white/10 bg-primary" data-tone="dark">
  <dl
    class="mx-auto grid max-w-6xl grid-cols-2 gap-y-10 px-6 py-14 sm:grid-cols-4 sm:py-16"
  >
    {
      stats.map((stat) => (
        <div class="flex flex-col-reverse px-4 text-center">
          <dt class="mt-4 text-sm leading-relaxed text-secondary">
            {stat.label}
          </dt>
          <dd>
            <span class="sr-only">{formatStat(stat)}</span>
            <span
              aria-hidden="true"
              data-counter
              data-value={stat.value}
              data-prefix={stat.prefix ?? ""}
              data-suffix={stat.suffix ?? ""}
              class="block font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl"
            >
              {formatStat(stat)}
            </span>
            <span class="mx-auto mt-4 block h-0.5 w-10 rounded-full bg-accent" />
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<script>
  const counters = Array.from(
    document.querySelectorAll<HTMLElement>("[data-counter]"),
  );

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const render = (el: HTMLElement, value: number) => {
    const prefix = el.dataset.prefix ?? "";
    const suffix = el.dataset.suffix ?? "";
    el.textContent = `${prefix}${value}${suffix}`;
  };

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.value ?? "0");
    const duration = 1400;
    const start = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      render(el, Math.round(target * eased));
      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        render(el, target);
      }
    };

    requestAnimationFrame(tick);
  };

  if (!reduceMotion && counters.length > 0 && "IntersectionObserver" in window) {
    counters.forEach((el) => render(el, 0));

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    counters.forEach((el) => observer.observe(el));
  }
</script>

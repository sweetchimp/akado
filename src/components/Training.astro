---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { trainingItems } from "../data/training";
---

<Section id="training" title="Training & Mentorship">
  <div class="grid gap-6 lg:grid-cols-2">
    {
      trainingItems.map((item) => (
        <article class="rounded-2xl border border-primary/10 bg-secondary/30 p-6 sm:p-8">
          <span
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-secondary"
            aria-hidden="true"
          >
            <Icon name={item.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-5 font-serif text-xl font-bold leading-snug text-primary">
            {item.title}
          </h3>
          <p class="mt-4 leading-relaxed text-ink/80">{item.body}</p>

          {
            item.assignments && (
              <div class="mt-6 border-t border-primary/15 pt-5">
                <h4
                  class="text-sm font-semibold uppercase tracking-wider text-primary"
                >
                  Recent training assignments
                </h4>
                <ul class="mt-4 space-y-4">
                  {
                    item.assignments.map((assignment) => (
                      <li>
                        <p class="text-sm font-semibold text-primary">
                          {assignment.year} &middot; {assignment.client}
                        </p>
                        <p class="mt-1 text-sm leading-relaxed text-ink/80">
                          {assignment.description}
                        </p>
                      </li>
                    ))
                  }
                </ul>
              </div>
            )
          }
        </article>
      ))
    }
  </div>
</Section>
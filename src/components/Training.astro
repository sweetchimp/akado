---
import Section from "./Section.astro";
import { trainingItems } from "../data/training";
---

<Section id="training" title="Training & Mentorship" variant="surface">
  <div class="grid gap-6 lg:grid-cols-2">
    {
      trainingItems.map((item) => (
        <article class="rounded-2xl border border-primary/15 bg-white p-6 shadow-sm sm:p-8">
          <h3 class="font-serif text-xl font-bold leading-snug text-primary">
            {item.title}
          </h3>
          <p class="mt-4 leading-relaxed text-ink/80">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>
